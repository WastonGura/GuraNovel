# Async SQLAlchemy / Alembic URL. Do not commit real credentials.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/guranovel

# POSIX/Linux/WSL project workspace base. Override the default:
# ~/.local/share/guranovel/workspaces
WORKSPACE_BASE_DIR=/home/your-service-user/.local/share/guranovel/workspaces

# Default is fake and needs no provider configuration. For an OpenAI-compatible
# deployment, set these only in ignored .env or the deployment secret manager.
CHAPTER_GENERATION_PROVIDER=fake
CHAPTER_PRODUCTION_PROVIDER=fake
READER_PANEL_PROVIDER=fake
READER_PANEL_MODE=off
OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
OPENAI_COMPATIBLE_MODEL=your-model-identifier
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=30
# Optional, only when supported by the provider: none|low|medium|high|max.
# OPENAI_COMPATIBLE_REASONING_EFFORT=none
# Set OPENAI_COMPATIBLE_API_KEY only in backend/.env or a deployment secret manager.
