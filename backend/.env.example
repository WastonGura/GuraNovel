# Async SQLAlchemy / Alembic URL. Do not commit real credentials.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/guranovel

# POSIX/Linux/WSL project workspace base. Override the default:
# ~/.local/share/guranovel/workspaces
WORKSPACE_BASE_DIR=/home/your-service-user/.local/share/guranovel/workspaces
